{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.21",
        "maatwebsite/excel": "^4.0.6",
        "phpoffice/phpword": "dev-master#91a1d0d978ff2cff382134c5d0f80c4a03dffd2e"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan document-fonts:sync --no-interaction",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "deploy": [
            "@php artisan migrate --force --no-interaction",
            "@php artisan document-fonts:sync --no-interaction",
            "@php artisan queue:restart --no-interaction"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "add-skills": [
            "@php artisan boost:add-skill https://github.com/affaan-m/ecc --skill=laravel-patterns",
            "@php artisan boost:add-skill https://github.com/wshobson/agents --skill=typescript-advanced-types",
            "@php artisan boost:add-skill https://github.com/nextlevelbuilder/ui-ux-pro-max-skill --skill=ui-ux-pro-max --skill=ui-styling",
            "@php artisan boost:add-skill https://github.com/leonxlnx/taste-skill --skill=taste-skill",
            "@php artisan boost:add-skill https://github.com/hugeicons/hugeicons --skill=hugeicons",
            "@php artisan boost:add-skill https://github.com/shadcn-ui/ui.git --skill=shadcn",
            "@php artisan boost:add-skill https://github.com/mattpocock/skills.git --skill=code-review --skill=codebase-design --skill=grill-with-docs --skill=improve-codebase-architecture --skill=grill-me"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
